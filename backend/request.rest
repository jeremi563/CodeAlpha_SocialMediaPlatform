### ---- Validation failure cases ----

### 2.4 Missing full name - expect 400
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "username": "tester1",
  "email": "tester1@example.com",
  "password": "password123"
}

### 2.5 Invalid username (uppercase + spaces) - expect 400
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "Test User",
  "username": "Invalid Name",
  "email": "tester2@example.com",
  "password": "password123"
}

### 2.6 Username too short - expect 400
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "Test User",
  "username": "ab",
  "email": "tester3@example.com",
  "password": "password123"
}

### 2.7 Invalid email format - expect 400
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "Test User",
  "username": "tester4",
  "email": "not-an-email",
  "password": "password123"
}

### 2.8 Password too short - expect 400
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "Test User",
  "username": "tester5",
  "email": "tester5@example.com",
  "password": "short"
}

### 2.9 Duplicate username - expect 409
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "Someone Else",
  "username": "johnmwangi",
  "email": "different@example.com",
  "password": "password123"
}

### 2.10 Duplicate email - expect 409
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "fullName": "Someone Else",
  "username": "differentuser",
  "email": "john@example.com",
  "password": "password123"
}


### ============================================================
### 3. LOGIN (Phase 3 - Section 9.1)
### ============================================================

### 3.1 Login with username - should return 200 and set cookie
# @name loginA
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "identifier": "johnmwangi",
  "password": "supersecret123"
}

### 3.2 Login with email - should return 200
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "identifier": "john@example.com",
  "password": "supersecret123"
}

### 3.3 Login with mixed-case username - should succeed (normalized)
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "identifier": "JohnMwangi",
  "password": "supersecret123"
}

### 3.4 Login with wrong password - expect 401, generic error
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "identifier": "johnmwangi",
  "password": "wrongpassword"
}

### 3.5 Login with nonexistent user - expect 401, SAME generic error
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "identifier": "ghostuser",
  "password": "whatever123"
}

### 3.6 Login with missing identifier - expect 400
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "password": "supersecret123"
}

### 3.7 Login as user B (used for follow tests later)
# @name loginB
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "identifier": "alicew",
  "password": "anothersecret456"
}


### ============================================================
### 4. CURRENT USER (Phase 3 - Section 9.1)
### ============================================================

### 4.1 Get current user - requires being logged in
### Run 3.1 first so the session cookie is set
GET {{baseUrl}}/api/auth/me

### 4.2 Get current user without a session - expect 401
### NOTE: The REST Client may still send the cookie from a previous
### login. To force this test, run "Restart" on the request in the
### REST Client panel to clear the cookie jar, then send it.
GET {{baseUrl}}/api/auth/me


### ============================================================
### 5. LOGOUT (Phase 3 - Section 9.1)
### ============================================================

### 5.1 Logout - should return 200 and clear the session cookie
POST {{baseUrl}}/api/auth/logout

### 5.2 Verify session is gone - expect 401
GET {{baseUrl}}/api/auth/me

### 5.3 Logout again (idempotent) - should still return 200
POST {{baseUrl}}/api/auth/logout


